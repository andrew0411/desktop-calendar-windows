<Window x:Class="DesktopCalendar.App.DayEventsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="날짜 일정" Icon="Assets/AppIcon.ico" Width="460" Height="410" MinWidth="400" MinHeight="330" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource UiWindowBackgroundBrush}" Foreground="{DynamicResource UiTextPrimaryBrush}">
    <Window.Resources>
        <Style x:Key="CloseButton" TargetType="Button" BasedOn="{StaticResource UiButtonBase}">
            <Setter Property="Background" Value="{DynamicResource UiAccentBrush}"/><Setter Property="Foreground" Value="{DynamicResource UiOnAccentBrush}"/>
            <Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="18,8"/><Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Opacity" Value="0.86" /></Trigger>
                <Trigger Property="IsSelected" Value="True"><Setter Property="Opacity" Value="0.72" /></Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid Margin="26,24,26,22">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,16">
            <TextBlock x:Name="DateTitle" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource UiTextPrimaryBrush}" />
            <TextBlock Text="일정을 더블클릭하면 상세 내용을 편집할 수 있습니다." FontSize="12" Foreground="{DynamicResource UiTextMutedBrush}" Margin="0,5,0,0" />
        </StackPanel>
        <ListBox x:Name="EventsList" Grid.Row="1" MouseDoubleClick="EventsList_MouseDoubleClick"
                 Background="{DynamicResource UiSurfaceBrush}" BorderBrush="{DynamicResource UiBorderBrush}" BorderThickness="1" Padding="10">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Background="{Binding BackgroundHex}" BorderBrush="{Binding ColorHex}" BorderThickness="3,0,0,0" CornerRadius="8" Padding="11,9">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border Width="18" Height="18" CornerRadius="9" Margin="0,0,7,0" Background="{DynamicResource UiSuccessBrush}"
                                    Visibility="{Binding IsCompleted, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Path Data="M 3 8 L 7 12 L 15 4" Stroke="White" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            </Border>
                            <TextBlock Grid.Column="1" Text="{Binding Emoji}" FontFamily="Segoe UI Emoji" FontSize="16" Margin="0,0,7,0"
                                       VerticalAlignment="Center" Visibility="{Binding HasEmoji, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            <TextBlock Grid.Column="2" Text="{Binding DisplayText}" FontWeight="Medium" TextDecorations="{Binding TextDecorations}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource UiTextPrimaryBrush}" />
                                        <Style.Triggers><DataTrigger Binding="{Binding IsCompleted}" Value="True"><Setter Property="Foreground" Value="{DynamicResource UiSuccessBrush}"/><Setter Property="FontWeight" Value="SemiBold"/></DataTrigger></Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <Button Grid.Row="2" Content="닫기" HorizontalAlignment="Right" Margin="0,14,0,0" Click="Close_Click" Style="{StaticResource CloseButton}" />
    </Grid>
</Window>
